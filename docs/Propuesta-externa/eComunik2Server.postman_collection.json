      "description": "Código de artículo de ejemplo para pruebas"
    },
    {
      "key": "pedidoId",
      "value": "1",
      "type": "string",
      "description": "ID de pedido de ejemplo para pruebas"
    },
    {
      "key": "vendedorCodigo",
      "value": "31",
