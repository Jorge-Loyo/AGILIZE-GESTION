      "key": "baseUrl",
      "value": "http://localhost:9000",
      "type": "string",
      "description": "URL base del servidor. Cambiar con la IP real del servidor."
    },
    {
      "key": "depositoPorDefecto",
      "value": "1",
      "type": "string",
      "description": "Código de depósito por defecto para consultas de inventario"
    },
    {
      "key": "clienteId",
      "value": "1",
