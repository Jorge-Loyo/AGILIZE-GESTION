  "item": [
    {
      "name": "🟢 Health Check",
      "item": [
        {
          "name": "GET / — Estado del servidor",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            },
            "description": "Verifica el estado del servidor, la conexión a la base de datos y lista todos los endpoints disponibles.\n\nRespuesta incluye:\n- Estado del servidor (online/offline)\n- Versión de la API\n- Estado de la base de datos\n- Depósito por defecto configurado\n- Lista de endpoints disponibles"
          },
          "response": [
            {
              "name": "200 OK - Servidor activo",
              "originalRequest": {
                "method": "GET",
                "url": { "raw": "{{baseUrl}}/" }
              },
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"status\": \"online\",\n  \"message\": \"API REST - Sistema de Inventario y Ventas\",\n  \"version\": \"0.9.8\",\n  \"architecture\": \"Modular\",\n  \"database\": \"Connected: True\",\n  \"config\": {\n    \"depositoPorDefecto\": 1\n  },\n  \"endpoints\": {\n    \"clientes\": \"/cliente\",\n    \"productos\": \"/articulo\",\n    \"pedidos\": \"/orders\",\n    \"depositos\": \"/deposito\",\n    \"vendedores\": \"/vendedor\",\n    \"usuarios\": \"/usuario\"\n  }\n}"
            }
          ]
        }
      ]
    },
