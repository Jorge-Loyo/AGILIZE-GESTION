/* === TEMA OSCURO PREMIUM - Agilize Gestión === */

* {
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog, QWidget {
    background-color: #0f0f0f;
    color: #F8F9FA;
}

/* --- Sidebar --- */
#sidebar {
    background-color: #161616;
    border-right: 1px solid #252525;
}

#sidebar QPushButton {
    background-color: transparent;
    color: #8a8a8a;
    border: none;
    border-radius: 10px;
    padding: 11px 14px;
    text-align: left;
    font-size: 13px;
    margin: 2px 0px;
}

#sidebar QPushButton:hover {
    background-color: #1f1f1f;
    color: #F8F9FA;
}

#sidebar QPushButton:checked, #sidebar QPushButton[active="true"] {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #D4AF37, stop:1 #b8962e);
    color: #0f0f0f;
    font-weight: bold;
}

/* --- Botones generales --- */
QPushButton {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #D4AF37, stop:1 #b8962e);
    color: #0f0f0f;
    border: none;
    border-radius: 8px;
    padding: 8px 18px;
    font-weight: bold;
    font-size: 13px;
}

QPushButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #e0c04a, stop:1 #D4AF37);
    color: #0f0f0f;
}

QPushButton:pressed {
    background-color: #9a7d26;
    padding-top: 9px;
    color: #0f0f0f;
}

QPushButton:disabled {
    background-color: #1f1f1f;
    color: #555555;
}

/* --- Inputs --- */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QTimeEdit {
    background-color: #1a1a1a;
    color: #F8F9FA;
    border: 1px solid #2a2a2a;
    border-radius: 8px;
    padding: 7px 12px;
    font-size: 13px;
    min-height: 18px;
    selection-background-color: #D4AF37;
    selection-color: #0f0f0f;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus, QTimeEdit:focus {
    border: 1px solid #D4AF37;
    background-color: #1f1f1f;
}

QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled {
    background-color: #141414;
    color: #444444;
    border-color: #1f1f1f;
}

QLineEdit::placeholder {
    color: #555555;
}

/* --- ComboBox dropdown --- */
QComboBox::drop-down {
    border: none;
    padding-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: #1a1a1a;
    color: #F8F9FA;
    border: 1px solid #2a2a2a;
    border-radius: 8px;
    selection-background-color: #D4AF37;
    selection-color: #0f0f0f;
}

/* --- Labels --- */
QLabel {
    color: #F8F9FA;
}

QLabel#title {
    font-size: 22px;
    font-weight: bold;
    color: #D4AF37;
}

QLabel#subtitle {
    font-size: 11px;
    color: #777777;
}

QLabel#error {
    color: #ff6b6b;
    font-size: 12px;
}

/* --- Tablas --- */
QTableWidget, QTableView {
    background-color: #0f0f0f;
    alternate-background-color: #141414;
    color: #F8F9FA;
    border: 1px solid #1f1f1f;
    border-radius: 10px;
    gridline-color: #1f1f1f;
    selection-background-color: #D4AF37;
    selection-color: #0f0f0f;
}

QTableWidget::item, QTableView::item {
    padding: 6px 8px;
    border-bottom: 1px solid #1a1a1a;
}

QTableWidget::item:selected, QTableView::item:selected {
    background-color: #D4AF37;
    color: #0f0f0f;
}

QHeaderView::section {
    background-color: #161616;
    color: #888888;
    border: none;
    border-bottom: 2px solid #D4AF37;
    padding: 8px 10px;
    font-weight: bold;
    font-size: 11px;
    text-transform: uppercase;
}

/* --- Tabs --- */
QTabWidget::pane {
    border: 1px solid #1f1f1f;
    border-radius: 8px;
    background-color: #0f0f0f;
}

QTabBar::tab {
    background-color: #161616;
    color: #888888;
    padding: 10px 20px;
    margin-right: 2px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    font-size: 12px;
}

QTabBar::tab:selected {
    background-color: #0f0f0f;
    color: #D4AF37;
    font-weight: bold;
    border-bottom: 2px solid #D4AF37;
}

QTabBar::tab:hover:!selected {
    background-color: #1f1f1f;
    color: #F8F9FA;
}

/* --- ScrollBar --- */
QScrollBar:vertical {
    background-color: transparent;
    width: 6px;
    border-radius: 3px;
    margin: 4px 2px;
}

QScrollBar::handle:vertical {
    background-color: #333333;
    border-radius: 3px;
    min-height: 40px;
}

QScrollBar::handle:vertical:hover {
    background-color: #D4AF37;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 6px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal {
    background-color: #333333;
    border-radius: 3px;
}

/* --- Cards / Frames --- */
QFrame#card {
    background-color: #161616;
    border: 1px solid #222222;
    border-radius: 14px;
    padding: 16px;
}

/* --- GroupBox --- */
QGroupBox {
    background-color: #141414;
    border: 1px solid #222222;
    border-radius: 12px;
    padding: 20px 16px 12px 16px;
    margin-top: 12px;
}

QGroupBox::title {
    color: #D4AF37;
    subcontrol-origin: margin;
    left: 16px;
    padding: 2px 8px;
}

/* --- CheckBox --- */
QCheckBox {
    color: #F8F9FA;
    spacing: 6px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #444444;
    border-radius: 4px;
    background-color: #1a1a1a;
}

QCheckBox::indicator:checked {
    background-color: #D4AF37;
    border-color: #D4AF37;
}

QCheckBox::indicator:hover {
    border-color: #D4AF37;
}

/* --- RadioButton --- */
QRadioButton {
    color: #F8F9FA;
    spacing: 6px;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #444444;
    border-radius: 8px;
    background-color: #1a1a1a;
}

QRadioButton::indicator:checked {
    background-color: #D4AF37;
    border-color: #D4AF37;
}

/* --- TextEdit --- */
QTextEdit {
    background-color: #1a1a1a;
    color: #F8F9FA;
    border: 1px solid #2a2a2a;
    border-radius: 8px;
    padding: 8px;
}

QTextEdit:focus {
    border: 1px solid #D4AF37;
}

/* --- Tooltips --- */
QToolTip {
    background-color: #1f1f1f;
    color: #F8F9FA;
    border: 1px solid #D4AF37;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

/* --- MessageBox --- */
QMessageBox {
    background-color: #161616;
}

QMessageBox QLabel {
    color: #F8F9FA;
}

/* --- Mensajes --- */
QLabel#success {
    color: #4ade80;
}

QLabel#warning {
    color: #fbbf24;
}


/* Sub-sidebar Administrador */
#sub_sidebar {
    background-color: #1a1a1a;
    border-right: 1px solid #2a2a2a;
}
#sub_sidebar_btn {
    text-align: left;
    padding: 4px 8px;
    border-radius: 3px;
    font-size: 11px;
    color: #999;
    background-color: transparent;
}
#sub_sidebar_btn:hover {
    background-color: #252525;
    color: #ddd;
}
#sub_sidebar_btn:checked {
    background-color: #2a2a2a;
    color: #D4AF37;
}


/* Calendar popup */
QCalendarWidget {
    min-width: 300px;
    min-height: 250px;
}
QCalendarWidget QAbstractItemView {
    font-size: 13px;
    selection-background-color: #D4AF37;
    selection-color: #0f0f0f;
}
QCalendarWidget QAbstractItemView::item {
    padding: 6px;
    min-width: 32px;
    min-height: 28px;
}
QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #1a1a1a;
    min-height: 32px;
}
QCalendarWidget QToolButton {
    color: #F8F9FA;
    font-size: 12px;
    padding: 4px 8px;
}
